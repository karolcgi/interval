{
  "name": "interval",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "description": "Interval — a local-first personal time blocking and time tracking app",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/acceptance.mjs && node e2e/phase2.mjs && node e2e/phase3.mjs && node e2e/focus.mjs",
    "e2e:focus": "node e2e/focus.mjs",
    "e2e:desktop": "tauri build --no-bundle && node e2e/desktop.mjs",
    "e2e:phase2": "node e2e/phase2.mjs",
    "e2e:phase3": "node e2e/phase3.mjs",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-global-shortcut": "^2.4.1",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "lucide-react": "^1.80.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.17.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^22.20.6",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.16.1",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright": "^1.63.0",
    "typescript": "~5.9",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}
